---
import HomeLayout from "@fumapress/astro/components/HomeLayout.astro";
---

<HomeLayout title="Fumapress on Astro" description="The truly flexible docs framework on React.js.">
  <div class="flex flex-1 flex-col items-center justify-center p-4 text-center">
    <h1 class="mb-2 text-xl font-bold">Fumapress on Astro.</h1>
    <p class="mb-4 text-fd-muted-foreground">The truly flexible docs framework on React.js.</p>
    <a
      class="rounded-full bg-fd-primary px-4 py-2.5 text-sm font-medium text-fd-primary-foreground"
      href="/docs"
    >
      Open Docs
    </a>
  </div>
</HomeLayout>
