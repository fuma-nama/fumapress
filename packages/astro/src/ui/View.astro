---
import { pageAlternate, type PageAlternate, type View } from "@fumapress/core";
import HomeLayout from "../components/HomeLayout.astro";
import ReactContent from "../components/ReactContent.astro";
import type { ExpandedView } from "../routes/shared.js";
import { getPressContext } from "../runtime.js";

interface Props {
  view: ExpandedView;
  /** the result of its `view()` */
  content: View;
}

const { view, content } = Astro.props;
const ctx = getPressContext();
const alternates: PageAlternate[] = [];
if (view.translations.length > 1)
  for (const { locale, path } of view.translations)
    alternates.push(pageAlternate(ctx, locale, path));
---

<HomeLayout
  title={content.title}
  description={content.description}
  lang={view.route.lang}
  alternates={alternates}
>
  <ReactContent node={content.node} />
</HomeLayout>
