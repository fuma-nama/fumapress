---
import type { Page } from "fumadocs-core/source";
import ReactContent from "../components/ReactContent.astro";
import Island from "../island/Island.astro";
import { getPressContext } from "../runtime.js";
import Layout from "./Layout.astro";
import { getDocsPage, getHomeLayout } from "./page.js";

interface Props {
  page: Page;
}

const { page } = Astro.props;
// the view of a plugin replaces the docs layout and your `page` module
const view = await getPressContext().getPageView(page);
const home = view && (await getHomeLayout(Astro, { lang: page.locale }));
const docs = view ? undefined : await getDocsPage(Astro, page);
const Content = docs?.Content;
---

<Layout page={page}>
  {
    view && home && (
      <Island {...home.island} persist="home">
        <ReactContent node={view.node} />
      </Island>
    )
  }
  {
    docs && (
      <Island {...docs.layout} persist="docs">
        {docs.body ? <Island {...docs.body} /> : Content && <Content provider={docs.provider} />}
      </Island>
    )
  }
</Layout>
