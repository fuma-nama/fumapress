---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { adapter } from "virtual:fumapress/astro";
import Layout from "../ui/Layout.astro";
import { getPage } from "../ui/page.js";
import { ctx } from "./context.js";
import { pageStaticPaths } from "./shared.js";

export const getStaticPaths = (() => pageStaticPaths(ctx, adapter)) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const page = await getPage(Astro, Astro.props);
if (page instanceof Response) return page;
---

<Layout {...page} />
