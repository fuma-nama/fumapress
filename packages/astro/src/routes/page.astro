---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { adapter } from "virtual:fumapress/astro";
import Page from "../ui/Page.astro";
import { getPressContext } from "../runtime.js";
import { pageStaticPaths, pageTarget } from "./shared.js";

export const getStaticPaths = (() =>
  pageStaticPaths(getPressContext(), adapter)) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const target = await pageTarget(Astro.props, Astro.request);
if (target instanceof Response) return target;
---

<Page {...target} />
