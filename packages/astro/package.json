{
  "name": "@fumapress/astro",
  "version": "0.0.0",
  "description": "Fumapress on Astro",
  "keywords": [
    "Astro",
    "Docs",
    "Fumadocs",
    "Fumapress",
    "astro-integration",
    "withastro"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./runtime": "./dist/runtime.js",
    "./package.json": "./package.json",
    "./components/*": "./dist/components/*",
    "./css/default.css": "./css/default.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "devalue": "^6.0.2",
    "flexsearch": "^0.8.212"
  },
  "devDependencies": {
    "@astrojs/react": "^7.1.1",
    "@fumadocs/astro": "^0.2.0",
    "@fumapress/core": "workspace:*",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "fumadocs-core": "^16.17.11",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.16.2",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@astrojs/react": "^7.0.0",
    "@fumadocs/astro": "^0.2.0",
    "@fumapress/core": "workspace:^",
    "@types/mdx": "*",
    "@types/react": "*",
    "astro": "^7.4.0",
    "fumadocs-core": "^16.17.11",
    "fumadocs-ui": "^16.16.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.0.0",
    "takumi-js": "^2.14.0"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
