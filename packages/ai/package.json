{
  "name": "@fumapress/ai",
  "version": "0.7.1",
  "description": "AI integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./components/search": "./dist/components/search.mjs",
    "./i18n": "./dist/i18n.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.17",
    "@fuma-translate/react": "^1.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^7.0.16",
    "cnfast": "^0.0.8",
    "flexsearch": "^0.8.212",
    "fumapress": "workspace:*",
    "lucide-react": "^1.23.0",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.2",
    "@types/hast": "^3.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fumadocs-core": "^16.11.1",
    "fumadocs-ui": "^16.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumadocs-ui": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
