  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./components/chat": "./dist/components/chat.mjs",
