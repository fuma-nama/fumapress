    "ai": "^7.0.165",
    "flexsearch": "^0.8.212",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-core": "^16.18.3",
    "fumadocs-ui": "^16.18.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "^16.18.3",
    "fumadocs-ui": "^16.18.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
