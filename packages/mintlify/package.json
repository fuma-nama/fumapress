{
  "name": "@fumapress/mintlify",
  "version": "0.0.4",
  "description": "Mintlify auto-migration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./openapi": "./dist/openapi.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "fumapress": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "fumadocs-core": "^16.9.3",
    "fumadocs-openapi": "^10.10.3",
    "fumadocs-ui": "^16.9.3",
    "react": "^19.2.7",
    "tsdown": "0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "fumadocs-core": "*",
    "fumadocs-openapi": "*",
    "fumadocs-ui": "*",
    "hono": "*"
  },
  "peerDependenciesMeta": {
    "fumadocs-openapi": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
