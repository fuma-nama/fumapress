{
  "name": "@fumapress/mintlify",
  "version": "2.0.0",
  "description": "Mintlify auto-migration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./asyncapi": "./dist/asyncapi.mjs",
    "./openapi": "./dist/openapi.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumapress/core": "workspace:^",
    "lucide-react": "^1.71.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fumadocs/asyncapi": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "fumadocs-core": "^16.19.0",
    "fumadocs-openapi": "^12.6.1",
    "fumadocs-ui": "^16.19.0",
    "react": "^19.3.1",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@fumadocs/asyncapi": "*",
    "fumadocs-core": "*",
    "fumadocs-openapi": "*",
    "fumadocs-ui": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@fumadocs/asyncapi": {
      "optional": true
    },
    "fumadocs-openapi": {
      "optional": true
    }
  }
}
