{
  "name": "@fumapress/mintlify",
  "version": "1.1.4",
  "description": "Mintlify auto-migration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./asyncapi": "./dist/asyncapi.mjs",
    "./openapi": "./dist/openapi.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fumadocs/asyncapi": "^0.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "fumadocs-core": "^16.16.2",
    "fumadocs-openapi": "^12.3.0",
    "fumadocs-ui": "^16.16.2",
    "fumapress": "workspace:*",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "waku": "1.0.0-rc.1"
  },
  "peerDependencies": {
    "@fumadocs/asyncapi": "*",
    "fumadocs-core": "*",
    "fumadocs-openapi": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:^",
    "hono": "*",
    "react": "*",
    "waku": "*"
  },
  "peerDependenciesMeta": {
    "@fumadocs/asyncapi": {
      "optional": true
    },
    "fumadocs-openapi": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
