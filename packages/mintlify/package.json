{
  "name": "@fumapress/mintlify",
  "version": "0.1.0",
  "description": "Mintlify auto-migration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./asyncapi": "./dist/asyncapi.mjs",
    "./openapi": "./dist/openapi.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fumadocs/asyncapi": "^0.1.0",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "fumadocs-core": "^16.11.0",
    "fumadocs-openapi": "^11.1.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.11.0",
    "fumapress": "workspace:*",
    "hono": "^4.12.28",
    "react": "^19.2.7",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@fumadocs/asyncapi": "*",
    "fumadocs-core": "*",
    "fumadocs-openapi": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:*",
    "hono": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@fumadocs/asyncapi": {
      "optional": true
    },
    "fumadocs-openapi": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
