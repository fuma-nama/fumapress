{
  "name": "@fumapress/feedback",
  "version": "0.5.0",
  "description": "Feedback integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./email": "./dist/email.mjs",
    "./github": "./dist/github.mjs",
    "./i18n": "./dist/i18n.mjs",
    "./schema": "./dist/schema.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.8",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.9.1",
    "fumadocs-ui": "^16.9.1",
    "fumapress": "workspace:*",
    "lucide-react": "^1.16.0",
    "octokit": "^5.0.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
