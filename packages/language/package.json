{
  "name": "@fumapress/language",
  "version": "1.1.4",
  "description": "Common language packs for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./zh-cn": "./dist/zh-cn.mjs",
    "./zh-tw": "./dist/zh-tw.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/language": "^0.2.19"
  },
  "devDependencies": {
    "@fumapress/ai": "workspace:*",
    "@fumapress/blog": "workspace:*",
    "@fumapress/feedback": "workspace:*",
    "@types/node": "^26.6.6",
    "fumadocs-core": "^16.19.0",
    "fumadocs-openapi": "^12.6.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.19.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "fumadocs-core": "*"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    }
  }
}
