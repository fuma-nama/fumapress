{
  "name": "@fumapress/language",
  "version": "1.0.0-beta.2",
  "description": "Common language packs for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./zh-cn": "./dist/zh-cn.mjs",
    "./zh-tw": "./dist/zh-tw.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/language": "^0.2.2"
  },
  "devDependencies": {
    "@fumapress/ai": "workspace:*",
    "@fumapress/feedback": "workspace:*",
    "@types/node": "^26.1.2",
    "fumadocs-core": "^16.14.0",
    "fumadocs-openapi": "^11.2.3",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.14.0",
    "fumapress": "workspace:*",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@fumapress/ai": "1.0.0-beta.2",
    "@fumapress/feedback": "1.0.0-beta.2",
    "fumadocs-core": "*",
    "fumapress": "1.0.0-beta.2"
  },
  "peerDependenciesMeta": {
    "@fumapress/ai": {
      "optional": true
    },
    "@fumapress/feedback": {
      "optional": true
    },
    "fumadocs-core": {
      "optional": true
    },
    "fumapress": {
      "optional": true
    }
  }
}
