{
  "name": "@fumapress/sanity",
  "version": "1.1.2",
  "description": "Sanity CMS integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "Sanity"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@fumadocs/sanity": "^0.2.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "fumadocs-core": "^16.15.7",
    "fumapress": "workspace:*",
    "react": "^19.2.8",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@sanity/types": "*",
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumapress": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@sanity/types": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fumadocs/sanity": "0.2.2"
  }
}
