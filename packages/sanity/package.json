{
  "name": "@fumapress/sanity",
  "version": "0.0.1",
  "description": "Sanity CMS integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "Sanity"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "fumadocs-core": "^16.9.1",
    "fumapress": "workspace:*",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "fumadocs-core": "*",
    "fumapress": "*"
  },
  "peerDependenciesMeta": {
    "fumadocs-core": {
      "optional": true
    },
    "fumapress": {
      "optional": true
    }
  },
  "dependencies": {
    "@fumadocs/sanity": "^0.0.4"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  }
}
