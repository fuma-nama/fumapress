{
  "name": "@fumapress/sanity",
  "version": "0.0.10",
  "description": "Sanity CMS integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "Sanity"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.23.0",
    "fumapress": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fumadocs/sanity": "^0.0.5",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "fumadocs-core": "^16.10.7",
    "react": "^19.2.7",
    "tsdown": "0.22.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@sanity/types": "*",
    "@types/react": "*",
    "fumadocs-core": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@sanity/types": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fumadocs/sanity": "0.0.5"
  }
}
