{
  "name": "@fumapress/notion",
  "version": "1.1.3",
  "description": "Notion content source and renderer for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "Notion"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "./css/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./renderer": "./dist/renderer.mjs",
    "./source": "./dist/source.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@notionhq/client": "^5.26.0",
    "cn": "^0.4.0",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-core": "^16.15.14",
    "fumadocs-ui": "^16.15.14",
    "fumapress": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
