{
  "name": "@fumapress/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Fumapress for Vue: a docs framework on Vite, Vue Router and Nitro",
  "keywords": [
    "Docs",
    "Fumapress",
    "Vue"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "runtime",
    "theme",
    "ui",
    "css"
  ],
  "type": "module",
  "exports": {
    "./config": "./dist/config.js",
    "./content": "./dist/content.js",
    "./client": "./dist/client.js",
    "./server": "./dist/server.js",
    "./page-tree": "./dist/page-tree.js",
    "./highlight": "./dist/highlight.js",
    "./vite": "./dist/vite.js",
    "./jsx-runtime": "./dist/jsx-runtime.js",
    "./jsx-dev-runtime": "./dist/jsx-runtime.js",
    "./theme": "./theme/index.ts",
    "./theme/*": "./theme/*",
    "./ui/*": "./ui/*/index.ts",
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/tailwind": "^0.1.5",
    "@pierre/highlights": "^0.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/hast": "^3.0.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "hast-util-from-dom": "^5.0.1",
    "lucide-vue-next": "^1.0.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm-table": "^2.1.2",
    "nitro": "3.0.261103-rc",
    "reka-ui": "^2.11.0",
    "satteri": "^0.11.7",
    "scroll-into-view-if-needed": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "vue-router": "^5.5.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@fumadocs/satteri": "^0.8.3",
    "@orama/core": "^1.2.19",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "algoliasearch": "^5.64.0",
    "fumadocs-core": "^16.19.3",
    "motion-v": "^2.12.0",
    "tsdown": "0.23.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@orama/core": "1.x.x",
    "algoliasearch": "5.x.x",
    "motion-v": "^2.12.0",
    "vite": "^8.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@orama/core": {
      "optional": true
    },
    "algoliasearch": {
      "optional": true
    },
    "motion-v": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
