{
  "name": "@fumapress/obsidian",
  "version": "0.1.0",
  "description": "Obsidian content source and renderer for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "Obsidian"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "./css/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-obsidian": "^1.0.1"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "fumadocs-core": "^16.13.0",
    "fumadocs-ui": "^16.13.0",
    "fumapress": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@types/mdx": "*",
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
