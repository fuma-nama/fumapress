{
  "name": "fumapress",
  "version": "1.1.1",
  "description": "An opinionated docs framework powered by Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "bin": {
    "fumapress": "./cli.js"
  },
  "files": [
    "dist",
    "css",
    "cli.js",
    "LICENSE.vitefu"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./adapters/mdx": "./dist/adapters/mdx.js",
    "./adapters/mdx/schema": "./dist/adapters/mdx/schema.js",
    "./cli": "./dist/cli.js",
    "./client": "./dist/client.js",
    "./i18n": "./dist/i18n.js",
    "./image": "./dist/image.js",
    "./layouts/blog": "./dist/layouts/blog.js",
    "./layouts/blog.index": "./dist/layouts/blog.index.js",
    "./layouts/blog.tags": "./dist/layouts/blog.tags.js",
    "./layouts/docs": "./dist/layouts/docs.js",
    "./layouts/glass": "./dist/layouts/glass.js",
    "./layouts/home": "./dist/layouts/home.js",
    "./layouts/notebook": "./dist/layouts/notebook.js",
    "./layouts/root": "./dist/layouts/root.js",
    "./layouts/switch": "./dist/layouts/switch.js",
    "./markdown": "./dist/markdown.js",
    "./plugins/asyncapi": "./dist/plugins/asyncapi.js",
    "./plugins/blog": "./dist/plugins/blog.js",
    "./plugins/flexsearch": "./dist/plugins/flexsearch.js",
    "./plugins/image/cloudflare": "./dist/plugins/image/cloudflare.js",
    "./plugins/image/self-hosted": "./dist/plugins/image/self-hosted.js",
    "./plugins/image/vercel": "./dist/plugins/image/vercel.js",
    "./plugins/image/vercel.enhancer": "./dist/plugins/image/vercel.enhancer.js",
    "./plugins/link-validation": "./dist/plugins/link-validation.js",
    "./plugins/llms.txt": "./dist/plugins/llms.txt.js",
    "./plugins/openapi": "./dist/plugins/openapi.js",
    "./plugins/orama-search": "./dist/plugins/orama-search.js",
    "./plugins/robots": "./dist/plugins/robots.js",
    "./plugins/rss": "./dist/plugins/rss.js",
    "./plugins/sitemap": "./dist/plugins/sitemap.js",
    "./plugins/takumi": "./dist/plugins/takumi.js",
    "./router": "./dist/router/index.js",
    "./router/fs": "./dist/router/fs.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css",
    "./css/default.css": "./css/default.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch --clean false",
    "build": "tsdown",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fuma-translate/react": "^1.0.2",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.1.0",
    "flexsearch": "^0.8.212",
    "lucide-react": "^1.34.0",
    "takumi-js": "^2.12.0",
    "vite": "^8.2.2",
    "waku": "1.0.0-rc.0",
    "xml-js": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@fumadocs/asyncapi": "0.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fumadocs-core": "^16.15.4",
    "fumadocs-mdx": "^15.4.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "^16.15.4",
    "hono": "^4.13.5",
    "http-cache-semantics": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resolve.exports": "^2.0.3",
    "sharp": "^0.35.4",
    "tsdown": "0.22.14",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@fumadocs/asyncapi": "0.x.x",
    "@types/mdx": "*",
    "@types/react": "*",
    "fumadocs-core": "^16.10.0",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-openapi": "^11.0.0",
    "fumadocs-ui": "^16.10.0",
    "hono": "*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "@fumadocs/asyncapi": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "fumadocs-openapi": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "fumadocs-mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "inlinedDependencies": {
    "@fastify/deepmerge": "3.2.1",
    "http-cache-semantics": "4.2.0",
    "resolve.exports": "2.0.3"
  }
}
