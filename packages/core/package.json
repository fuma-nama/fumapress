{
  "name": "fumapress",
  "version": "0.4.0",
  "description": "An opinionated docs framework powered by Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css",
    "LICENSE.vitefu"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./adapters/mdx": "./dist/adapters/mdx.js",
    "./adapters/mdx/schema": "./dist/adapters/mdx/schema.js",
    "./i18n": "./dist/i18n.js",
    "./layouts/blog": "./dist/layouts/blog.js",
    "./layouts/blog.index": "./dist/layouts/blog.index.js",
    "./layouts/blog.tags": "./dist/layouts/blog.tags.js",
    "./layouts/docs": "./dist/layouts/docs.js",
    "./layouts/home": "./dist/layouts/home.js",
    "./layouts/notebook": "./dist/layouts/notebook.js",
    "./layouts/root": "./dist/layouts/root.js",
    "./layouts/switch": "./dist/layouts/switch.js",
    "./plugins/blog": "./dist/plugins/blog.js",
    "./plugins/flexsearch": "./dist/plugins/flexsearch.js",
    "./plugins/llms.txt": "./dist/plugins/llms.txt.js",
    "./plugins/openapi": "./dist/plugins/openapi.js",
    "./plugins/orama-search": "./dist/plugins/orama-search.js",
    "./plugins/takumi": "./dist/plugins/takumi.js",
    "./router": "./dist/router.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css",
    "./css/default.css": "./css/default.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch --clean false",
    "build": "tsdown",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@takumi-rs/image-response": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "^16.9.0",
    "fumadocs-ui": "^16.9.0",
    "lucide-react": "^1.16.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.0.14",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fastify/deepmerge": "^3.2.1",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "fumadocs-mdx": "^15.0.7",
    "fumadocs-openapi": "^10.9.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "0.22.0",
    "typescript": "^6.0.3",
    "waku": "1.0.0-beta.0"
  },
  "peerDependencies": {
    "@types/mdx": "*",
    "@types/react": "*",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-openapi": "^10.8.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "waku": "1.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "fumadocs-openapi": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "fumadocs-mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "inlinedDependencies": {
    "@fastify/deepmerge": "3.2.1"
  }
}
