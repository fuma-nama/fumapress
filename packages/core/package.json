{
  "name": "@fumapress/core",
  "version": "0.1.1",
  "description": "The framework-agnostic core of Fumapress: the engine, site config and plugins",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "LICENSE.vitefu"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./page-tree": "./dist/page-tree.mjs",
    "./plugins/flexsearch": "./dist/plugins/flexsearch.mjs",
    "./plugins/link-validation": "./dist/plugins/link-validation.mjs",
    "./plugins/llms.txt": "./dist/plugins/llms.txt.mjs",
    "./plugins/orama-search": "./dist/plugins/orama-search.mjs",
    "./plugins/robots": "./dist/plugins/robots.mjs",
    "./plugins/rss": "./dist/plugins/rss.mjs",
    "./plugins/sitemap": "./dist/plugins/sitemap.mjs",
    "./plugins/takumi": "./dist/plugins/takumi.mjs",
    "./runtime": "./dist/runtime/index.mjs",
    "./runtime/vite": "./dist/runtime/vite.mjs",
    "./ui/docs": "./dist/ui/docs.mjs",
    "./ui/home": "./dist/ui/home.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "flexsearch": "^0.8.212",
    "fumadocs-core": "^16.18.3",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.18.3",
    "react": "^19.3.1",
    "takumi-js": "^2.20.0",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@types/react": "*",
    "flexsearch": "*",
    "fumadocs-core": "^16.18.3",
    "fumadocs-ui": "^16.18.3",
    "react": "^19.2.0",
    "takumi-js": "^2.14.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "flexsearch": {
      "optional": true
    },
    "fumadocs-ui": {
      "optional": true
    },
    "takumi-js": {
      "optional": true
    }
  }
}
