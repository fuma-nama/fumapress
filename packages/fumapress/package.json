{
  "name": "fumapress",
  "version": "2.0.1",
  "description": "An opinionated docs framework powered by Fumadocs",
  "keywords": [
    "Docs",
    "Fumadocs"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "bin": {
    "fumapress": "./cli.js"
  },
  "files": [
    "dist",
    "css",
    "cli.js"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/router/client-entry.browser.js",
    "./dist/router/client-entry.ssr.js"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./client": "./dist/client.js",
    "./image": "./dist/image.js",
    "./markdown": "./dist/markdown.js",
    "./plugins/flexsearch": "./dist/plugins/flexsearch.js",
    "./plugins/image/cloudflare": "./dist/plugins/image/cloudflare.js",
    "./plugins/image/self-hosted": "./dist/plugins/image/self-hosted.js",
    "./plugins/image/vercel": "./dist/plugins/image/vercel.js",
    "./plugins/image/vercel.enhancer": "./dist/plugins/image/vercel.enhancer.js",
    "./plugins/link-validation": "./dist/plugins/link-validation.js",
    "./plugins/llms.txt": "./dist/plugins/llms.txt.js",
    "./plugins/orama-search": "./dist/plugins/orama-search.js",
    "./plugins/robots": "./dist/plugins/robots.js",
    "./plugins/rss": "./dist/plugins/rss.js",
    "./plugins/sitemap": "./dist/plugins/sitemap.js",
    "./plugins/takumi": "./dist/plugins/takumi.js",
    "./plugins/takumi.wasm": "./dist/plugins/takumi.wasm.js",
    "./router": "./dist/router/index.js",
    "./router/deploy.enhancer": "./dist/router/deploy.enhancer.js",
    "./router/fs": "./dist/router/fs.js",
    "./schema": "./dist/schema.js",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css",
    "./css/default.css": "./css/default.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch --clean false",
    "build": "tsdown",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumapress/core": "workspace:^",
    "flexsearch": "^0.8.212",
    "lucide-react": "^1.70.0",
    "takumi-js": "^2.19.0",
    "vite": "^8.3.6",
    "waku": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@types/http-cache-semantics": "^4.2.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "fumadocs-core": "^16.18.2",
    "fumadocs-mdx": "^15.5.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@^16.18.2",
    "hono": "^4.13.17",
    "http-cache-semantics": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resolve.exports": "^2.0.4",
    "sharp": "^0.35.5",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@types/mdx": "*",
    "@types/react": "*",
    "fumadocs-core": "^16.18.2",
    "fumadocs-mdx": "^15.5.1",
    "fumadocs-ui": "^16.18.2",
    "hono": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@types/mdx": {
      "optional": true
    },
    "fumadocs-mdx": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "inlinedDependencies": {
    "http-cache-semantics": "4.3.0",
    "resolve.exports": "2.0.4"
  }
}
