{
  "name": "@fumapress/graphql",
  "version": "1.1.1",
  "description": "Generate docs for your GraphQL schema with Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Fumapress",
    "GraphQL"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": [
    "./css/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./ui": "./dist/ui.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --clean false",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/graphql": "^0.2.2",
    "graphql": "^17.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fumadocs-core": "^16.15.3",
    "fumadocs-ui": "^16.15.3",
    "fumapress": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumapress": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
