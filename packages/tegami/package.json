    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "fumadocs-core": "^16.14.0",
    "fumadocs-ui": "^16.14.0",
    "fumapress": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tegami": "^1.3.1",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tegami": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
