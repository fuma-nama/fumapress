{
  "name": "@fumapress/tegami",
  "version": "1.1.3",
  "description": "Tegami integration for Fumapress",
  "keywords": [
    "Docs",
    "Fumadocs",
    "Tegami"
  ],
  "homepage": "https://press.fumadocs.dev",
  "license": "MIT",
  "author": "Fuma Nama",
  "repository": "github:fuma-nama/fumapress",
  "files": [
    "dist",
    "css"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./schema": "./dist/schema.mjs",
    "./tegami": "./dist/tegami.mjs",
    "./package.json": "./package.json",
    "./css/preset.css": "./css/preset.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "cn": "^0.2.5",
    "lucide-react": "^1.40.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "fumadocs-core": "^16.15.7",
    "fumadocs-ui": "^16.15.7",
    "fumapress": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tegami": "^1.5.0",
    "tsdown": "0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@types/react": "*",
    "fumadocs-core": "*",
    "fumadocs-ui": "*",
    "fumapress": "workspace:^",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tegami": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
